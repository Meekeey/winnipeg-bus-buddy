# Winnipeg Transit Open Data API key (server only, never sent to the browser).
# Get one free at https://api.winnipegtransit.com/
WT_API_KEY=

# Optional: daily GTFS refresh (see README).
# A Deploy Hook URL from Vercel > Project > Settings > Git > Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=
# Any long random text. Vercel sends it to the cron route as a Bearer token.
CRON_SECRET=

# Optional: set to 1 to try the app with made-up times and no API key.
NEXT_PUBLIC_DEMO=
